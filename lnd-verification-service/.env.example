# Copy this file to .env and adjust as needed.
# Local dev default: SQLite, zero setup required.
DATABASE_URL=sqlite:///./verification.db

# Swap to Postgres once you move off your laptop, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lnd_verification

# Name-match guardrail: similarity score (0-1) above which two names are
# considered a match. Tune this once you test against real Credly pages.
NAME_MATCH_THRESHOLD=0.82

# Timeout for outbound calls to credential-issuer public pages (seconds).
REQUEST_TIMEOUT_SECONDS=10
